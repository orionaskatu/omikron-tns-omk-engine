; ---------------------------------------------------------------------------
; omk.ini - the game's settings, and this port's.
;
;     build/omk-play <gamedata> <tables> --config omk.ini
;
; EVERY ROW IS COMMENTED OUT, and that is the point: with nothing set, the
; port runs exactly as the game does. Uncomment only what you mean to change.
;
; Copy it somewhere and edit the copy - this file is the template and is not
; read by anything.
;
; ---- WHERE A SETTING COMES FROM, and which source wins -------------------
;
; There are three, in order of increasing authority:
;
;   1. the DEFAULTS compiled into the engine (`sub_41F4C0`);
;   2. this file - `[Preferences]` is the engine's OWN section and its key
;      names are the binary's, not names invented here;
;   3. the SAVE FILE's 3496-byte header, which carries all 74 option rows and
;      is written on every slot save. It is later than the ini, so it WINS for
;      anything a player has touched in the options menu.
;
; ...and a command-line flag beats all three, because it is the most recent
; word of all. `docs/GAME_STATE.md` 8a, `todo/options-config.md`.
;
; So: with a save loaded, editing `[Preferences]` here may change nothing.
; That is the engine's own precedence and not a fault.
; ===========================================================================


[Preferences]
; The engine's own section. The 65 keys the binary reads are in
; `verify.py: preferences keys`; the ones below are those this port acts on.

; --- options menu, "Vidéo" -------------------------------------------------

; Row 3, "Distance de clipping" - in METRES against an inch world unit, and it
; sizes FOUR things at once: the visible-set radius, both render-bucket splits
; (x0.25 and x0.95) and the fog's range. The menu offers five:
;   25 Très proche | 50 Proche | 100 Intermédiaire | 150 Loin | 200 Très loin
; A set's own clip distance is used unless it is 0 or exceeds this, so the
; option can only ever REDUCE. Default 50.
;clipdistance = 50

; Row 4, "Affichage du ciel" - 0 Non, 1 Oui. The sky is a flat painted CEILING
; (a 12x12 quad grid, not a dome) that follows the camera in x and z. Default 1.
;displaysky = 1

; Row 5, "Affichage des ombres" - 0 Non, 1 Oui. The character shadows: a soft
; blob under each of a set of BONES, how many decided by row 7 below.
; `docs/ASSETS.md` 4d. Default 1.
;displayshadows = 1

; --- the device rows -------------------------------------------------------

; Row 2, "Résolution". The interface is authored at 640x480 and scaled.
;screen_x = 640
;screen_y = 480
;
; The save header's copy (what the options menu last saved) beats these, and
; `--res` beats both. The menu's row 2 changes the size live.

; FULLSCREEN - the game's own key: 0 is fullscreen, nonzero a window. The
; original treats a missing key as 0; this viewer keeps a window unless told
; (`--fullscreen` / `--window` beat it, and F11 toggles while running).
;window = 0

; --- options menu, "Audio" -------------------------------------------------
;
; ALL THREE ARE ATTENUATIONS, not volumes: 0 is full and 100 is silent. That
; is the sense the ini, the save header and `Music_SetVolume` all use, and the
; engine's default is 0 for each - so a larger number is quieter.

; Row 10, "Volume des dialogues"
;DialogAttenuation = 0
; Row 11, "Volume des musiques"
;music = 0
; Row 12, "Volume des effets sonores"
;FxAttenuation = 0

; --- the mouse -------------------------------------------------------------
;MouseSensX = 0
;MouseSensY = 0


[Options]
; THIS PORT'S OWN SECTION, for the two option rows the engine has no ini key
; for. They are not invented settings: both are real rows of the game's menu
; and both persist in the save header. They simply have nowhere to live in the
; engine's ini, so they live here.

; Row 6, "Niveau d'activité dans les rues" - the CROWD DENSITY, and it is a
; SPACING rather than a count: `Slider_Init` spawns a pedestrian every
; `39 * (5 - level) * h[3]` units along a lane, so a HIGHER level is a BUSIER
; street. The menu offers five:
;   0 Très faible | 1 Faible | 2 Intermédiaire | 3 Important | 4 Très important
; It thins the pedestrians only - the road traffic ignores it.
; NO DEFAULT of the engine's: `sub_41F4C0` does not write this field, so the
; docs' own table leaves it blank and the port declares 0. `docs/GAME_STATE.md`
; 8a. Both shipped saves carry a value a player chose (4 and 3).
;streetactivity = 0

; Row 7, "Niveau de détail" - 0 Faible, 1 Intermédiaire, 2 Important.
; It decides how many BONES cast a shadow: the chest always, plus the head and
; the four leg bones from 1, plus the four arm bones at 2. An actor who is
; neither the player nor his fight opponent always draws one level coarser.
; No engine default either, for the same reason as row 6 above; the port
; declares 0, which casts the chest alone.
;levelofdetail = 0


[Enhancements]
; NOT THE GAME. Everything in this section is something the original never
; did, and every one of them is OFF unless written here. Only the Vulkan
; backend draws them - the software renderer stands where Direct3D stood and
; draws what the game drew - with one stated exception, noted below.
; `todo/enhancements.md` carries the list and the evidence.

; EVERYTHING AT ONCE: `all = max` turns every enhancement below as high as it
; goes, without your having to know what the list currently is. It is a BASE -
; any specific key in this section beats it, whatever order they appear in -
; and it touches nothing outside `[Enhancements]`, because the game's own
; option rows are not enhancements. `off` (the default) leaves each alone.
; The two the DEVICE caps (MSAA and anisotropy) are asked for at their largest
; defined value; the backend reduces what it cannot meet and says so.
;all = off

; MSAA samples per pixel: 0 off, else 2, 4 or 8 (the largest the device
; supports at or below what is asked). The original sets ANTIALIAS off.
;antialiasing = 0

; Texture filtering: nearest | bilinear | trilinear (or 0 | 1 | 2).
; NOT an enhancement at bilinear, the DEFAULT: the original filtered bilinear
; with no mip chain on a 3D card and sampled POINT on its software devices.
; A GPU backend draws bilinear; the software reference always point-samples.
; `nearest` is the software devices' picture on a GPU; `trilinear` (the
; enhancement) generates a mip chain at upload, Vulkan only. The colour key
; travels in the texture's alpha so a filtered edge does not fringe.
;texturefiltering = bilinear

; Anisotropic filtering, 1 to 16; 1 is off. With trilinear only.
;anisotropy = 1

; Lighting: pervertex | perpixel (or 0 | 1).
;   pervertex  what the engine does - the `.3DO` lights applied per VERTEX and
;              to the procedural crowd alone, which is where all eight of
;              `sub_4380B0`'s call sites are;
;   perpixel   the SAME law - the same reach test, the same linear falloff,
;              the same `-(N.L)` - evaluated per fragment, and received by
;              every character. A body the engine lights is shaded from BLACK
;              (its model ships white); a body it does not gets the lights
;              added to its baked colour. Vulkan only.
;lighting = pervertex

; Supersampling: 1 off, 2 or 4. Renders the frame N times larger each way and
; averages it down - N of 4 is SIXTEEN times the fill. Not the same as
; antialiasing above: MSAA smooths geometry edges, this also reaches the
; texture aliasing and the CUTOUT edges (grilles, railings, signs) whose
; silhouette is a colour key inside a triangle. Vulkan only.
;supersampling = 1

; Interface scaling: nearest | linear (or 0 | 1). The interface is authored at
; 640x480 and its coordinates are scaled to the display, so on any other size
; every interface bitmap is stretched - and DirectDraw's Blt, what the game
; stretches with, takes one texel. `linear` filters that stretch. The colour
; key still decides the silhouette, so a keyed edge cannot fringe. This is the
; ONE key here that is not Vulkan-only: the interface is composed on the CPU
; for both backends. At 640x480 it changes nothing, because nothing stretches.
;uiscaling = nearest

; TEXT SCALING: the original scales the interface's layout to the display but
; draws the GLYPHS at their native size, so text shrinks as the resolution
; grows - at 4K it is a sixth of its 640x480 size. `fit` scales the glyphs by
; the smaller of width/640 and height/480 (filtered when uiscaling = linear).
; Both backends. `game` (the default) is what the original draws.
;textscaling = game

; UNLIMITED DRAW DISTANCE: `clipdistance = 0` here means "no cap". This is the
; option's own name under a different section, because it IS that option
; pushed past the range the menu offers - the five values it allows stop at
; 200 m. A 0 under [Preferences] is a bad value and stays clamped to 1; only
; this section's means unlimited.
;
; The FOG goes with it. The fog's range is the clip distance (it starts at a
; quarter of it and ends at it), so with no distance there is nothing to fade
; over and the fog is off.
;
; Measured before you turn it on: at the option's 200 m maximum this changes
; NO pixel in any of the four cities - the sets have no sightline that far -
; while drawing 368 more mesh runs. It is worth having if you have turned the
; option down, and it costs nothing when it is off. `todo/enhancements.md` 4.
;clipdistance = capped

; Character shadows: classic | fitted | mapped (or 0 | 1 | 2).
; SUBORDINATE to `displayshadows` above - with that off, nothing draws
; whatever this says.
;   classic  what the engine draws: one flat blob per bone, laid at the height
;            probed under the bone's own centre, so at a step it is cut off
;            dead at the lip;
;   fitted   the same blobs, subdivided and laid on the surface under them, so
;            they follow a kerb, a slope and a stair. This one is NOT
;            backend-gated - it changes the geometry the port generates rather
;            than how a backend rasterises it, and two backends building
;            different geometry would break the property the renderer boundary
;            rests on;
;   mapped   a real shadow map, cast by the set's OWN authored lights (153 of
;            Anekbah's 155 are street lamps pointing straight down). Characters
;            cast, the world receives. Vulkan only.
;shadowquality = classic

; Shoot mode's RADAR, the wireframe minimap at the top right: game | always.
;   game     what the game does: a script turns it on - by itself in the
;            Archives, and in the seven other arenas that have one (the
;            supermarket among them) only when Kay'l carries object 980,
;            "Radar activé", which nothing in the game ever gives. So in
;            those seven it is cut content, and a player never saw it;
;   always   draw it in every shoot phase whose area has a radar file.
; `todo/enhancements.md` 10.
;radar = game

; The FRAME RATE the viewer presents at: 30..240, default 30. The original
; had no cap at all - it ran at the monitor's refresh with a frame delta of
; 30/fps - so this changes how often a frame is drawn, never how fast the
; game runs. Bodies still pose at 30 (the engine truncates to a key).
; `todo/enhancements.md` 11, `todo/sixty-fps.md`.
;framerate = 30

; ANIMATION between keys: game | smooth. The original poses a body from ONE
; key, the frame truncated (`_ftol`), so above 30 fps a body moves smoothly
; while its limbs step at 30; smooth slerps every bone between two keys.
; `todo/enhancements.md` 12.
;animation = game

; ESCAPE / BACKSPACE AS BACK: off | on. The original's interface BACK is the
; `Annuler / Sauter` binding alone - SPACE, or the pad's second button - and
; ESC only opens the pause screen, so in the sneak's verb panel (after choosing
; an object) ESC finds no way back to the tab column. `on` makes a fresh ESC or
; BACKSPACE send BACK while a screen is up (BACKSPACE still edits a focused
; name field). `todo/enhancements.md` 14.
;escapeback = off
;
; SSAO - screen-space ambient occlusion: the soft darkening of creases,
; corners and where a body meets the ground, from the depth buffer. The
; original has none (the sets' baked colours carry the artists' own shading).
; Vulkan only. `todo/enhancements.md` 15.
;ssao = off
;
; RAYTRACING - hybrid ray tracing: characters lit by the set around them (rays
; that pick up the set's baked colour - red beside a red neon; they receive no
; ray-traced shadow, their light stays the game's own), and ray-traced
; ambient occlusion in place of SSAO. The Direct3D 12 renderer on a
; GPU with DXR 1.1 only (`renderer = d3d12`). `todo/enhancements.md` 19.
;raytracing = off
;
; RTREFLECTIONS - ray-traced reflections on the wet ground: the street's road,
; pavement and floor meshes wet in patches, puddles mirroring the neon, the
; lamps, the shop windows and the passers-by, damp and dull between. Only with
; `raytracing = on` (it says so and stays off otherwise); the Direct3D 12
; renderer. In `all = max`. `todo/enhancements.md` 26. `--rt-reflections`.
;rtreflections = off
;
; FRAMEGEN - frame generation: between every two rendered frames an in-between
; picture, warped half-way along the motion vectors (both frames, with a depth
; test, so a passer-by or a car is moved rather than doubled), presented half an
; interval before the second - the window shows about twice the frames. The 2D
; is never interpolated (each frame's own over both). It adds half a frame of
; latency and changes neither the simulation nor any rendered frame. An
; in-between frame goes out only while a frame takes about two refreshes or
; more (60 Hz: 30 fps or fewer; 144 Hz: 72 or fewer) - with less the display
; has no refresh to show it in, and it is skipped rather than slow the game. The Direct3D 12 window only, off under
; MSAA (an upscaler turns MSAA off). In `all = max`. `todo/enhancements.md` 27.
; `--framegen`.
;framegen = off
;
; ANIMBLEND - where a body's clip changes (the player starting, stopping and
; turning, a fighter's moves, a walker stopping to idle) the jump to the new
; clip's first frame is eased out over 0.2 s instead of drawn at once. The
; drawn pose only: no timing, transition or hit changes. Cutscene clips and
; conversation lines are left alone. In `all = max`. `todo/enhancements.md` 28.
; `--anim-blend`.
;animblend = off
;
; LOD - a pedestrian model carries four bodies of falling detail and the game
; steps down one every 10 m, so past 10 m every walker is a coarser one. `best`
; keeps every walker on its most detailed body at any distance.
; `todo/enhancements.md` 16.
;lod = game
;
; VEHICLE SHINE - the sliders and motos get lamp highlights and a sky reflection.
; The game gives them none (their shine is painted into the texture).
; `todo/enhancements.md` 20.
;vehicleshine = off
;
; COLOUR DEPTH of the picture the window gets: 16 (the default) is the
; original's look - the 16-bit device's RGB565 with its 4x4 dither, which the
; GPU backends' present pass reproduces from the 8-bit-a-channel 3D; 32 hands
; the 3D over at 8 bits a channel, no quantisation, no dither (smooth skies and
; fog). On Direct3D 12 and Vulkan the frames with an interface over the 3D
; (HUD, subtitles, fades, screens) stay 32-bit too - the 2D, the game's own 565
; art, blended over the full-precision 3D on the GPU.
; `all = max` gives 32. `--colordepth 16|32`.
; `todo/enhancements.md` 21.
;colordepth = 16
;
; THE POST-PROCESSING CHAIN - on Direct3D 12 and on Vulkan (one GLSL source,
; the same numbers; HDR output and soft particles are still Direct3D 12's).
; Over the 3D only: the interface (HUD,
; subtitles, screens) is laid over it untouched. `todo/enhancements.md` 22.
;   bloom = on        light bleeding from the neon, the lamps and the fires -
;                     a tight glow round what nears white, not a haze. In
;                     `all = max`. `--bloom`.
;   dof = on          depth of field on the LETTERBOXED frames alone
;                     (conversations, cutscenes), focused where the camera
;                     aims. In `all = max`. `--dof`.
;   colorgrade = off|cyber|warm|noir|filmic   a colour grade: cyber (teal
;                     shadows, magenta-orange highlights - Anekbah's neon
;                     night), warm, noir (almost black and white), filmic (a
;                     neutral S-curve). A look, so NOT in `all = max`.
;                     `--colorgrade G`.
;   hdr = on          HDR10 output (an scRGB swapchain) when Windows reports
;                     the display as HDR, else a line and SDR. Asked for by
;                     name only. `--hdr`.
;bloom = off
;dof = off
;colorgrade = off
;hdr = off
;
; SOFT PARTICLES and VOLUMETRIC LAMP LIGHT - the Direct3D 12 backend's too;
; Vulkan says so and leaves them off. Both in `all = max`.
;   softparticles = on   the effect sprites - smoke, steam, the fires, the
;                     lamps' glows - fade where they meet a wall or the ground
;                     (over ~0.6 m of depth) instead of cutting a hard line.
;                     Needs a single-sample depth: off, with a line, under
;                     MSAA (an upscaler turns MSAA off, so FSR/DLSS have it).
;                     `todo/enhancements.md` 23. `--soft-particles`.
;   volumetrics = on  the street lamps' light scattered in the air round them:
;                     a soft warm halo near each lamp, not a haze (the set's
;                     own fog is left as it is). Half-size, added before the
;                     post chain; ~0.3 ms at 4K on an RX 9070 XT.
;                     `todo/enhancements.md` 24. `--volumetrics`.
;softparticles = off
;volumetrics = off
;
; TEXTURE PACK - a directory of replacement textures: upscaled (e.g. AI
; upscaled) PNGs of the models' and the sets' small palettised pages, laid out
; DIR/<group>/<model>/<MATERIAL>.png as `python3 tools/texpack.py extract DIR`
; writes them (then `texpack.py upscale DIR DIR4 --factor 4 [--tool
; realesrgan-ncnn-vulkan.exe]`, `texpack.py check DIR4`). Each replacement must
; be a whole multiple of the original's size (2x, 4x...), 8-bit RGB or RGBA;
; pure black stays the colour key. The game data is never touched. Empty (the
; default) is off; a relative path is taken from this file's directory. The
; Vulkan and Direct3D 12 renderers only. It names a directory, so `all = max`
; does not give it. `--texturepack DIR`. `todo/enhancements.md` 25.
;texturepack =
;
; UPSCALER - temporal upscaling: the frame drawn below the display size and
; rebuilt by AMD FSR (FSR 4 where the GPU runs it) or NVIDIA DLSS from its
; colour, depth and motion vectors. The Direct3D 12 renderer only
; ([Preferences] renderer = d3d12); Vulkan ignores it and says so. A DLSS the
; GPU cannot run falls back to FSR. Not part of `all = max`.
; `todo/enhancements.md` 18.
;upscaler = off
; ...and its render size: native (1.0x), quality (1.5x), balanced (1.7x),
; performance (2.0x), ultraperformance (3.0x).
;upscalequality = quality
