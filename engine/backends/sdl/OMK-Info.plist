<!-- `make app`: build/OMK.app around build/omk-play, so macOS sees a GAME.
     The category and the two Game Mode keys (LSSupportsGameMode, macOS 26;
     GCSupportsGameMode, macOS 14) make it ELIGIBLE for Game Mode, which the
     system turns on when the app is frontmost and full screen (F11) - the
     highest CPU and GPU priority. A bare binary is never eligible. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>omk-play</string>
    <key>CFBundleIdentifier</key>
    <string>org.omk.play</string>
    <key>CFBundleName</key>
    <string>OMK</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.adventure-games</string>
    <key>LSSupportsGameMode</key>
    <true/>
    <key>GCSupportsGameMode</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
